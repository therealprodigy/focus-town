{
  "name": "focus-town",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write src server db scripts tests *.ts *.json *.md .vscode",
    "build:cloudflare": "tsc -b && vite build --outDir dist-cloudflare",
    "deploy:cloudflare": "wrangler deploy",
    "db:migrate:cloudflare": "wrangler d1 migrations apply DB --remote",
    "build:hosted": "tsc -b && vite build --config vite.hosted.config.ts",
    "db:migrate:turso": "node scripts/migrate-libsql.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vercel": "^63.1.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "engines": {
    "node": ">=24"
  }
}
